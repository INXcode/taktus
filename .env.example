# Vorlage fuer `.env.local`. Diese Datei enthaelt ausschliesslich Platzhalter
# und ist die einzige `.env`-Variante, die versioniert wird.
#
# Zu jeder Variable steht, was passiert, wenn sie fehlt. Ein stiller Ausfall
# ist gefaehrlicher als ein lauter -- deshalb ist er hier jeweils benannt.
#
# Die lokalen Werte gibt `pnpm db:start` beim Start aus.


# --- Supabase -------------------------------------------------------------

# Basisadresse der Supabase-API. Lokal die Kong-Adresse aus dem eigenen
# Portblock (siehe docs/betrieb.md), produktiv die eigene Instanz.
# FEHLT DER WERT: Die Anwendung startet, jeder Datenbankzugriff scheitert.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:44421

# Oeffentlicher Schluessel. Darf im Browser landen -- er unterliegt
# vollstaendig der Row Level Security.
# FEHLT DER WERT: Anmeldung und alle Abfragen scheitern.
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key-aus-pnpm-db-start

# Service-Role-Schluessel. UMGEHT SAEMTLICHE RLS-POLICIES.
#
# Bewusst ohne `NEXT_PUBLIC_`-Praefix: Next.js wuerde ihn sonst ins
# Client-Bundle uebernehmen. Zusaetzlich schuetzen `import "server-only"` in
# src/lib/supabase/admin.ts, eine Semgrep-Regel und der CI-Job
# `bundle-secrets`, der das gebaute Bundle nach Schluesselmustern durchsucht.
#
# FEHLT DER WERT: Betriebsaufgaben wie Loeschlaeufe und Datenexport scheitern.
# GELANGT ER IN DEN CLIENT: vollstaendiger Datenbankzugriff aus dem Browser,
# ueber alle Mandanten hinweg.
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key-aus-pnpm-db-start

# Oeffentliche Adresse der Anwendung. Wird fuer Weiterleitungen nach der
# Anmeldung und fuer Links in E-Mails verwendet.
# FEHLT DER WERT: Bestaetigungs- und Zuruecksetzen-Links zeigen ins Leere --
# ein stiller Ausfall, der erst beim ersten echten Nutzer auffaellt.
NEXT_PUBLIC_SITE_URL=http://localhost:3100


# --- Sicherheit -----------------------------------------------------------

# Content-Security-Policy nur beobachten, statt durchzusetzen.
#
# Auf `true` gesetzt meldet der Browser Verstoesse in der Entwicklerkonsole,
# blockiert aber nichts. Gedacht fuer die schrittweise Einfuehrung: erst
# zusehen, dann scharf stellen. Die Richtlinie selbst steht in
# `src/lib/security/csp.ts`, gesetzt wird sie in `src/proxy.ts`.
#
# FEHLT DER WERT: Die Richtlinie wird durchgesetzt -- das ist die Vorgabe.
# Wer eine Schutzmassnahme standardmaessig ausschaltet, betreibt sie nicht.
# STEHT SIE DAUERHAFT AUF true: Die CSP ist wirkungslos. Der Header sieht
# vorhanden aus, und genau das macht diesen Zustand gefaehrlich.
# CSP_REPORT_ONLY=true
